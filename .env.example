# Where RSVP responses get sent. Configure at least one — see README.md.

# 1) Google Sheet, via a Google Apps Script "Web app" URL (recommended, free)
GOOGLE_SCRIPT_URL=

# 2) Email notification, via Resend (https://resend.com — free tier available)
RESEND_API_KEY=
RESEND_FROM_EMAIL=rsvp@yourdomain.com
NOTIFY_EMAIL=you@example.com
