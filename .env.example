# Database (SQLite by default for zero-config local dev; swap to Postgres by
# changing prisma/schema.prisma provider to "postgresql" and setting this to
# a postgres connection string, e.g. from Supabase or Neon)
DATABASE_URL="file:./dev.db"

# Admin auth
ADMIN_EMAIL="admin@saraandatef.com"
ADMIN_PASSWORD="change-me-now"
JWT_SECRET="replace-with-a-long-random-string"

# Public site URL (used for metadata / OG / sitemap)
NEXT_PUBLIC_SITE_URL="https://saraandatef.com"
