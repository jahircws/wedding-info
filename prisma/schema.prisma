// Prisma schema for Sara & Atef wedding site.
// Ships with SQLite for zero-config local dev.
// For production, swap provider to "postgresql" and point DATABASE_URL at
// e.g. Supabase / Neon / RDS, then run `npx prisma db push` (or migrate deploy).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

// One RSVP submission = one "party" led by a main guest, plus any additional
// guests they add under it.
model Party {
  id                 String   @id @default(cuid())
  mainName           String
  email              String
  phone              String? // WhatsApp number, for day-of updates
  attendingSunday    Boolean  @default(true) // Welcome evening, Casa de Pilatos
  attendingMonday    Boolean  @default(true) // Wedding day, Hacienda La Soledad
  hotel              String?
  shuttleToHacienda  Boolean  @default(false)
  shuttleBack        Boolean  @default(false)
  shuttleBackTime    String? // rough time, only meaningful when shuttleBack is true
  menuChoice         String? // "MEAT" | "FISH" | "VEGETARIAN" — main guest's own menu
  foodNotes          String? // allergies / intolerances for the main guest
  songRequest        String?
  notes              String? // anything else the couple should know
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // main guest's own approval status
  status             String   @default("PENDING") // "PENDING" | "APPROVED" | "DECLINED"

  guests             Guest[]
}

model Guest {
  id                String   @id @default(cuid())
  partyId           String
  party             Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  fullName          String
  attendingSunday   Boolean  @default(true)
  attendingMonday   Boolean  @default(true)
  shuttleToHacienda Boolean  @default(false)
  shuttleBack       Boolean  @default(false)
  shuttleBackTime   String? // rough time, only meaningful when shuttleBack is true
  menuChoice        String? // "MEAT" | "FISH" | "VEGETARIAN"
  foodNotes         String?
  status            String   @default("PENDING") // "PENDING" | "APPROVED" | "DECLINED"
  createdAt         DateTime @default(now())
}

// Singleton row holding admin-editable site content (date/venue/etc.)
model SiteSettings {
  id               String   @id @default("singleton")
  weddingDayOne    DateTime
  weddingDayTwo    DateTime
  venueName        String
  venueAddress     String
  ceremonyTime     String
  receptionTime    String
  mapUrl           String
  updatedAt        DateTime @updatedAt
}